{
  "name": "clashvpn-homes",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/favicon.svg",
      "!/apple-touch-icon.png",
      "!/og.png",
      "!/site.webmanifest",
      "!/robots.txt",
      "!/sitemap-index.xml",
      "!/sitemap-0.xml"
    ],
    "not_found_handling": "404-page"
  }
}
