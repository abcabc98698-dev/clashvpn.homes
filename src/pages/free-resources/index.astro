<script>
  // Copy buttons for rule URLs, Docker commands, and YAML snippets
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy-text]")) {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copyText;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const orig = btn.textContent;
        btn.textContent = "已复制 ✓";
        setTimeout(() => {
          btn.textContent = orig;
        }, 2000);
      } catch {
        // Ignore clipboard errors
      }
    });
  }

  // Diagnostic tools category filter
  const diagBtns = document.querySelectorAll<HTMLButtonElement>("[data-diag-filter]");
  const diagCards = document.querySelectorAll<HTMLElement>("[data-diag-card]");

  for (const btn of diagBtns) {
    btn.addEventListener("click", () => {
      const targetCat = btn.dataset.diagFilter || "all";
      for (const b of diagBtns) {
        const active = b === btn;
        b.classList.toggle("bg-accent", active);
        b.classList.toggle("text-accent-text", active);
        b.classList.toggle("bg-surface", !active);
        b.classList.toggle("text-muted", !active);
      }
      for (const card of diagCards) {
        const cat = card.dataset.diagCat || "";
        card.hidden = targetCat !== "all" && cat !== targetCat;
      }
    });
  }
</script>
