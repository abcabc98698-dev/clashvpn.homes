---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { FEATURED_BRAND } from "../data/brands";

const steps = [
  "我们的技术评测团队将阅读您提交的宽带运营商、设备环境与月度预算需求。",
  "我们将通过邮件为您推荐匹配的「主力 IEPL 专线 + 备用不限时流量包」组合方案及对应客户端教程。",
  "在等待邮件回复期间，您可以直接浏览全站 42 家机场实测档案或先体验榜首 #1 光速云。",
];
---

<BaseLayout title="选型咨询已收到" description="您的订阅选型与排障请求已成功提交。" noindex>
  <section class="relative overflow-x-clip">
    <div class="container-x py-20 sm:py-28">
      <div class="mx-auto max-w-2xl text-center">
        <span class="mx-auto grid size-20 place-items-center rounded-full bg-success/12 text-success">
          <Icon name="check" size={40} />
        </span>
        <h1 class="h-display mt-8 text-[clamp(2.25rem,1.6rem+2.8vw,3.5rem)]">我们已收到 <span class="hl">您的咨询请求</span></h1>
        <p class="lead mt-6">接下来的处理流程：</p>
      </div>
      <ol class="stagger mx-auto mt-12 grid max-w-2xl gap-4">
        {
          steps.map((step, i) => (
            <li class="card flex items-center gap-5 p-5 sm:p-6" style={`--i:${i}`}>
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent text-sm font-extrabold text-accent-text">{i + 1}</span>
              <span class="font-semibold">{step}</span>
            </li>
          ))
        }
      </ol>
      <div class="mx-auto mt-12 flex max-w-2xl flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-secondary btn-lg">返回首页总榜</a>
        <a href={`/brands/${FEATURED_BRAND.slug}/`} class="btn btn-primary btn-lg">
          <Icon name="bolt" /> 查看 #1 {FEATURED_BRAND.name}实测
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
