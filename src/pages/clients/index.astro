---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import QuoteSection from "../../components/sections/QuoteSection.astro";
import { PLATFORM_CLIENTS, CLIENT_FAQ } from "../../data/clients";
import { FEATURED_BRAND } from "../../data/brands";
import { SITE } from "../../config";
import { collectionPageJsonLd, faqPageJsonLd } from "../../lib/schema";

const site = Astro.site ?? new URL(SITE.url);
const crumbs = [{ label: "客户端大全" }];
const pageTitle =
  "2026 第三方代理客户端大全：Windows / Mac / 安卓 / iOS 小火箭 / Linux / OpenWrt 软路由下载与教程";
const pageDesc =
  "全平台 Clash 与代理客户端选型指南：收录 Clash Verge Rev、Mihomo Party、FlClash、v2rayN、Shadowrocket（小火箭）、Quantumult X、Stash、CMFA、v2rayA 及 OpenClash 软路由插件。";
const extraJsonLd = [
  collectionPageJsonLd(site, {
    name: pageTitle,
    description: pageDesc,
    urlPath: "/clients/",
  }),
  faqPageJsonLd(CLIENT_FAQ),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  crumbs={crumbs}
  extraJsonLd={extraJsonLd}
>
  <PageHeader
    title="全平台代理客户端 *下载与选型百科*"
    lead="覆盖 Windows、macOS（Intel 与 Apple Silicon M芯片）、Android、iPhone/iPad (iOS)、Linux 桌面/服务器与 OpenWrt 软路由六大平台，助您 3 分钟跑通高速订阅。"
    crumbs={crumbs}
  />

  <!-- Platform Quick Anchor Bar -->
  <section class="border-b border-line bg-surface py-5">
    <div class="container-x flex flex-wrap items-center justify-between gap-4">
      <div class="flex flex-wrap gap-2">
        {PLATFORM_CLIENTS.map((group) => (
          <a
            href={`#platform-${group.id}`}
            class="rounded-full border border-line bg-bg px-4 py-1.5 text-sm font-bold text-ink transition hover:border-accent hover:text-accent-ink"
          >
            {group.platform} ({group.apps.length})
          </a>
        ))}
      </div>
      <a href={`/brands/${FEATURED_BRAND.slug}/`} class="text-xs font-bold text-accent-ink hover:underline">
        不想折腾配置？查看带自研一键客户端的 #1 {FEATURED_BRAND.name} →
      </a>
    </div>
  </section>

  <!-- Self-Developed vs Universal Client Decision Box -->
  <section class="section pt-12 pb-6">
    <div class="container-x">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border border-white/15 bg-[#0A0F1D] p-6 sm:p-8 text-white">
          <span class="rounded-full bg-[#ff7a29] px-3 py-0.5 text-xs font-extrabold text-[#0b0e1c]">
            路线 A · 零基础新手首选
          </span>
          <h2 class="mt-3 font-display text-xl font-bold sm:text-2xl">
            机场官方自研免配置客户端（账号密码一键登录）
          </h2>
          <p class="mt-2.5 text-sm leading-relaxed text-[#94A3B8]">
            无需理解订阅链接、YAML 规则或 TUN 网卡。下载机场官方定制客户端后，直接输入注册邮箱与密码即可一键智能分流。
          </p>
          <ul class="mt-4 space-y-2 text-xs text-[#E2E8F0]">
            <li>● <strong>#1 光速云（推荐）</strong>：同时提供 Win/Mac/安卓自研客户端 + 标准通用订阅（优惠码 AMM 享 8 折，年付 ¥99）。</li>
            <li>● <strong>#3 微风 / #11 极连云 / #16 全球云</strong>：均支持官方一键客户端与第三方 Clash 订阅双模式。</li>
            <li>● <strong>注意避坑</strong>：#13 一帆云仅支持其专属客户端（限 2–3 台设备），不支持导入第三方 Clash 或软路由。</li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/brands/guangsuyun/" class="btn btn-primary text-xs">
              查看 #1 光速云客户端与评测
            </a>
            <a href="/brands/" class="btn btn-secondary border-white/20 bg-white/10 text-white text-xs">
              按客户端模式筛选 42 家品牌
            </a>
          </div>
        </div>

        <div class="card p-6 sm:p-8">
          <span class="rounded-full border border-line bg-surface px-3 py-0.5 text-xs font-extrabold text-ink">
            路线 B · 多机场双保险与极客玩家首选
          </span>
          <h2 class="mt-3 text-xl font-extrabold sm:text-2xl">
            第三方开源通用订阅客户端（Clash / Sing-box / Xray）
          </h2>
          <p class="mt-2.5 text-sm leading-relaxed text-muted">
            通过导入机场提供的标准订阅链接（Subscription URL），可在一个客户端内同时管理「主力包月专线 + 备用不限时流量包」，并支持按进程、域名或流媒体平台精细分流。
          </p>
          <ul class="mt-4 space-y-2 text-xs text-muted">
            <li>● <strong>桌面端黄金标准</strong>：Clash Verge Rev、Mihomo Party、FlClash（均搭载最新 Mihomo Meta 内核）。</li>
            <li>● <strong>移动端主力组合</strong>：iOS 端首选 Shadowrocket（小火箭）或 Stash；安卓端首选 CMFA 或 FlClash。</li>
            <li>● <strong>家庭网关透明代理</strong>：OpenWrt 软路由安装 OpenClash、PassWall2 或 Nikki，全家 Apple TV / PS5 免配直连。</li>
          </ul>
          <div class="mt-6">
            <a href="#platform-windows" class="btn btn-secondary text-xs">
              向下浏览 6 大平台客户端清单 ↓
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 Platform Sections -->
  <section class="section pt-6">
    <div class="container-x space-y-16">
      {PLATFORM_CLIENTS.map((group) => (
        <div id={`platform-${group.id}`} class="scroll-mt-24">
          <div class="border-b border-line pb-5">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="font-mono text-xs font-bold uppercase tracking-widest text-accent-ink">
                PLATFORM · {group.platform}
              </span>
              <span class="rounded-full bg-surface px-3 py-1 text-xs font-semibold text-muted">
                收录 {group.apps.length} 款主流工具
              </span>
            </div>
            <h2 class="mt-2 text-2xl font-extrabold tracking-tight sm:text-3xl">
              {group.title}
            </h2>
            <p class="mt-2 text-sm text-muted">{group.subtitle}</p>

            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              <div class="rounded-xl border border-accent/30 bg-accent-soft/40 p-3.5 text-xs leading-relaxed">
                <strong class="text-accent-ink">选型一句话建议：</strong>
                <span class="text-ink">{group.quickRecommendation}</span>
              </div>
              <div class="rounded-xl border border-line bg-surface p-3.5 text-xs leading-relaxed text-muted">
                <strong class="text-ink">安装与架构注意：</strong>
                <span>{group.warningNote}</span>
              </div>
            </div>
          </div>

          <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {group.apps.map((app) => (
              <article class="card flex flex-col justify-between p-6">
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <span
                      class:list={[
                        "rounded px-2.5 py-0.5 text-xs font-extrabold",
                        app.recommendedLevel === "首选推荐"
                          ? "bg-accent text-accent-text"
                          : app.recommendedLevel === "进阶推荐"
                            ? "bg-ink text-bg"
                            : "bg-surface text-muted border border-line",
                      ]}
                    >
                      {app.recommendedLevel}
                    </span>
                    <span class="font-mono text-xs font-bold text-ink">{app.pricing}</span>
                  </div>

                  <h3 class="mt-3 text-xl font-extrabold">{app.name}</h3>
                  <p class="mt-1 font-mono text-xs text-accent-ink">内核：{app.coreEngine}</p>

                  <p class="mt-3 text-sm leading-relaxed text-muted">{app.summary}</p>

                  <dl class="mt-4 space-y-2 rounded-xl bg-surface p-3 text-xs">
                    {app.archNote && (
                      <div>
                        <dt class="text-muted">安装包架构提示</dt>
                        <dd class="font-semibold text-ink">{app.archNote}</dd>
                      </div>
                    )}
                    <div>
                      <dt class="text-muted">支持协议</dt>
                      <dd class="font-mono text-ink">{app.protocols.join(" · ")}</dd>
                    </div>
                    <div>
                      <dt class="text-muted">适用人群</dt>
                      <dd class="text-ink">{app.suitableFor}</dd>
                    </div>
                  </dl>
                </div>

                <div class="mt-5 border-t border-line pt-4">
                  <a
                    href={app.downloadUrl}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    class="btn btn-secondary w-full py-2.5 text-xs font-bold"
                  >
                    前往 {app.downloadChannel} 下载 ↗
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Client FAQ Section -->
  <section class="border-t border-line bg-surface py-16 sm:py-20" aria-labelledby="client-faq-title">
    <div class="container-x">
      <h2 id="client-faq-title" class="h-section text-2xl sm:text-3xl">
        客户端订阅导入与 TUN 模式常见排障问答
      </h2>
      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        {CLIENT_FAQ.map((item) => (
          <div class="card p-6">
            <h3 class="text-base font-extrabold text-ink">{item.q}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-muted">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <QuoteSection title="遇到客户端导入报错或 TUN 模式冲突？" />
</BaseLayout>
