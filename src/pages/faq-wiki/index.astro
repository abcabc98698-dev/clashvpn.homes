  <script>
    const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.faq-cat-btn');
    const faqItems = document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]');
    const catSections = document.querySelectorAll<HTMLElement>('[data-category-section]');
    const emptyState = document.getElementById('faq-empty-state');
    const toggleAllBtn = document.getElementById('toggle-all-details') as HTMLButtonElement | null;
    const copyBtns = document.querySelectorAll<HTMLButtonElement>('.copy-code-btn');

    let currentCategory = 'all';

    function filterFaq() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let visibleCount = 0;

      faqItems.forEach((item) => {
        const itemCat = item.getAttribute('data-category') || '';
        const searchStr = item.getAttribute('data-search') || '';
        const matchesCat = currentCategory === 'all' || itemCat === currentCategory;
        const matchesQuery = !query || searchStr.includes(query);

        if (matchesCat && matchesQuery) {
          item.classList.remove('hidden');
          if (query) {
            item.open = true;
          }
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      catSections.forEach((sec) => {
        const secId = sec.getAttribute('data-category-section') || '';
        const hasVisible = sec.querySelectorAll('[data-faq-item]:not(.hidden)').length > 0;
        const matchesCat = currentCategory === 'all' || secId === currentCategory;
        if (matchesCat && hasVisible) {
          sec.classList.remove('hidden');
        } else {
          sec.classList.add('hidden');
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', filterFaq);

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-cat-filter') || 'all';
        catButtons.forEach((b) => {
          b.classList.remove('border-accent-500', 'bg-accent-500', 'text-ink-950', 'font-bold');
          b.classList.add('border-white/10', 'bg-white/5', 'text-ink-200');
        });
        btn.classList.remove('border-white/10', 'bg-white/5', 'text-ink-200');
        btn.classList.add('border-accent-500', 'bg-accent-500', 'text-ink-950', 'font-bold');
        filterFaq();
      });
    });

    toggleAllBtn?.addEventListener('click', () => {
      const isExpanded = toggleAllBtn.getAttribute('data-expanded') === 'true';
      const nextState = !isExpanded;
      faqItems.forEach((item) => {
        if (!item.classList.contains('hidden')) {
          item.open = nextState;
        }
      });
      toggleAllBtn.setAttribute('data-expanded', String(nextState));
      toggleAllBtn.textContent = nextState ? '折叠全部词条' : '展开全部词条';
    });

    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-copy-code') || '';
        try {
          await navigator.clipboard.writeText(code);
          const original = btn.textContent;
          btn.textContent = '✓ 已复制';
          setTimeout(() => {
            btn.textContent = original;
          }, 1800);
        } catch {
          // fallback ignored
        }
      });
    });
  </script>
