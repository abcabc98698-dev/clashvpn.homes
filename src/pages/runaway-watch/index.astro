  <script>
    // 1. Interactive 10-Point Runaway Risk Calculator
    const checkboxes = document.querySelectorAll<HTMLInputElement>('.risk-checkbox');
    const scoreNumber = document.getElementById('risk-score-number');
    const levelBadge = document.getElementById('risk-level-badge');
    const adviceBox = document.getElementById('risk-advice-box');
    const progressBar = document.getElementById('risk-progress-bar');
    const resetBtn = document.getElementById('reset-risk-calc');

    function updateRiskScore() {
      let score = 0;
      checkboxes.forEach((cb) => {
        if (cb.checked) {
          score += Number(cb.getAttribute('data-risk-weight') || 0);
        }
      });

      if (scoreNumber) scoreNumber.textContent = String(score);
      if (progressBar) progressBar.style.width = `${Math.max(3, Math.min(100, score))}%`;

      if (!levelBadge || !adviceBox || !scoreNumber || !progressBar) return;

      if (score === 0) {
        scoreNumber.className = 'font-display text-4xl font-bold text-emerald-400';
        levelBadge.className =
          'rounded-sm border border-emerald-500/40 bg-emerald-500/15 px-2.5 py-0.5 font-mono text-xs font-bold text-emerald-300';
        levelBadge.textContent = '安全稳定 · 正常运营';
        progressBar.className = 'h-full bg-emerald-500 transition-all duration-300';
        adviceBox.textContent =
          '当前未勾选任何高危信号。即便主力机场运营良好，仍建议在客户端常备一份「不限时永久流量包」作为跨机房容灾备份。';
      } else if (score <= 20) {
        scoreNumber.className = 'font-display text-4xl font-bold text-sky-400';
        levelBadge.className =
          'rounded-sm border border-sky-500/40 bg-sky-500/15 px-2.5 py-0.5 font-mono text-xs font-bold text-sky-300';
        levelBadge.textContent = '轻度观察 · 注意排查本地设置';
        progressBar.className = 'h-full bg-sky-500 transition-all duration-300';
        adviceBox.textContent =
          '风险尚处于低位，可能属于短期机房维护或本地 DNS 波动。建议先按本页「6步自检法」刷新订阅，并避免一次性续费超长周期。';
      } else if (score <= 45) {
        scoreNumber.className = 'font-display text-4xl font-bold text-amber-400';
        levelBadge.className =
          'rounded-sm border border-amber-500/40 bg-amber-500/15 px-2.5 py-0.5 font-mono text-xs font-bold text-amber-300';
        levelBadge.textContent = '中度预警 · 停止续费并准备备胎';
        progressBar.className = 'h-full bg-amber-500 transition-all duration-300';
        adviceBox.textContent =
          '已出现明显的运维缩水或资金链吃紧迹象！请立即停止在该机场续费任何新套餐，仅用完剩余流量，并马上配置好 #1 光速云 或 #7 威图云 备用订阅。';
      } else {
        scoreNumber.className = 'font-display text-4xl font-bold text-rose-400';
        levelBadge.className =
          'rounded-sm border border-rose-500/40 bg-rose-500/15 px-2.5 py-0.5 font-mono text-xs font-bold text-rose-300';
        levelBadge.textContent = '极高危告警 · 崩盘前兆！立即止损';
        progressBar.className = 'h-full bg-rose-500 transition-all duration-300';
        adviceBox.textContent =
          '高危警告：多项核心跑路指标同时命中（如大额低价促销 + 专线掉线 + 群组禁言），随时可能彻底关站失联！切勿再充值一分钱，请立即将主力业务迁移至实测 T0 专线品牌。';
      }
    }

    checkboxes.forEach((cb) => cb.addEventListener('change', updateRiskScore));
    resetBtn?.addEventListener('click', () => {
      checkboxes.forEach((cb) => {
        cb.checked = false;
      });
      updateRiskScore();
    });

    // 2. 42-Brand Monitor Table Search & Filter
    const monitorSearch = document.getElementById('brand-monitor-search') as HTMLInputElement | null;
    const monitorBtns = document.querySelectorAll<HTMLButtonElement>('.monitor-filter-btn');
    const monitorRows = document.querySelectorAll<HTMLTableRowElement>('[data-monitor-row]');
    let activeStatus = 'all';

    function filterMonitorTable() {
      const q = (monitorSearch?.value || '').trim().toLowerCase();
      monitorRows.forEach((row) => {
        const st = row.getAttribute('data-status') || '';
        const s = row.getAttribute('data-brand-search') || '';
        const matchStatus = activeStatus === 'all' || st === activeStatus;
        const matchQuery = !q || s.includes(q);
        if (matchStatus && matchQuery) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    }

    monitorSearch?.addEventListener('input', filterMonitorTable);
    monitorBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeStatus = btn.getAttribute('data-status-filter') || 'all';
        monitorBtns.forEach((b) => {
          b.classList.remove('border-accent-500', 'bg-accent-500', 'text-ink-950', 'font-bold');
          b.classList.add('border-white/10', 'bg-white/5', 'text-ink-200');
        });
        btn.classList.remove('border-white/10', 'bg-white/5', 'text-ink-200');
        btn.classList.add('border-accent-500', 'bg-accent-500', 'text-ink-950', 'font-bold');
        filterMonitorTable();
      });
    });

    // 3. Copy Fallback YAML Snippet
    const copyYamlBtn = document.getElementById('copy-fallback-yaml');
    copyYamlBtn?.addEventListener('click', async () => {
      const yaml = copyYamlBtn.getAttribute('data-yaml') || '';
      try {
        await navigator.clipboard.writeText(yaml);
        const orig = copyYamlBtn.textContent;
        copyYamlBtn.textContent = '✓ 已复制配置';
        setTimeout(() => {
          copyYamlBtn.textContent = orig;
        }, 1800);
      } catch {
        // ignore
      }
    });
  </script>
</BaseLayout>
