---
import type { AirportBrand } from "../../data/brands-types";
import { getSpeedtestStatusMeta } from "../../data/brands";

interface Props {
  brand: AirportBrand;
}

const { brand } = Astro.props;
const statusMeta = getSpeedtestStatusMeta(brand.speedtest.status);

function parseSpeedNum(download: string): number {
  const m = download.match(/(\d+(?:\.\d+)?)/);
  if (!m) return 45;
  const val = parseFloat(m[1]);
  return Math.min(100, Math.max(18, Math.round((val / 850) * 100)));
}
---

<section
  class="rounded-[18px] border border-white/10 bg-[#0A0F1D] p-6 sm:p-8 text-[#F8FAFC] shadow-2xl"
  aria-label={`${brand.name} 节点延迟与带宽性能监测报告`}
>
  <!-- Top Header Bar -->
  <div class="flex flex-wrap items-start justify-between gap-4 border-b border-white/10 pb-5">
    <div>
      <div class="flex items-center gap-2.5">
        <span
          class="inline-block h-2.5 w-2.5 rounded-full"
          style={`background:${brand.accentColor};box-shadow:0 0 12px ${brand.accentColor}`}
        ></span>
        <span class="font-mono text-xs uppercase tracking-widest text-[#94A3B8]">
          PERFORMANCE OBSERVATORY · 节点测速监控台
        </span>
      </div>
      <h3 class="mt-1.5 font-display text-xl font-bold text-white sm:text-2xl">
        {brand.name} 节点延迟与下行吞吐量报告
      </h3>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <span
        class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-mono text-xs font-semibold"
        style={`background:${statusMeta.bg};color:${statusMeta.color};border:1px solid ${statusMeta.border}`}
      >
        <span class="h-1.5 w-1.5 rounded-full" style={`background:${statusMeta.color}`}></span>
        {statusMeta.label}
      </span>
      <span class="rounded-full border border-white/10 bg-[#111827] px-3 py-1 font-mono text-xs text-[#94A3B8]">
        采样日期: {brand.speedtest.date}
      </span>
    </div>
  </div>

  <!-- Summary KPI Row -->
  <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded-xl border border-white/8 bg-[#111827]/90 p-3.5">
      <div class="text-xs text-[#64748B]">架构类型</div>
      <div class="mt-1 font-mono text-sm font-semibold text-[#F8FAFC]">{brand.lineType}</div>
    </div>
    <div class="rounded-xl border border-white/8 bg-[#111827]/90 p-3.5">
      <div class="text-xs text-[#64748B]">实测/归档协议</div>
      <div class="mt-1 font-mono text-sm font-semibold text-[#06B6D4]">
        {brand.speedtest.imageProtocol || brand.protocols.join(" / ")}
      </div>
    </div>
    <div class="rounded-xl border border-white/8 bg-[#111827]/90 p-3.5">
      <div class="text-xs text-[#64748B]">采样时间戳</div>
      <div class="mt-1 font-mono text-sm font-semibold text-[#F8FAFC] tabular-nums">
        {brand.speedtest.imageTestedAt || brand.speedtest.date}
      </div>
    </div>
    <div class="rounded-xl border border-white/8 bg-[#111827]/90 p-3.5">
      <div class="text-xs text-[#64748B]">主力节点覆盖</div>
      <div class="mt-1 font-mono text-sm font-semibold text-[#10B981]">
        {brand.nodeRegions.slice(0, 4).join(" · ")}
      </div>
    </div>
  </div>

  <!-- Node Speed Bars -->
  <div class="mt-6 space-y-3.5">
    <div class="flex items-center justify-between text-xs font-mono uppercase tracking-wider text-[#64748B]">
      <span>区域节点抽样 (Region & Route)</span>
      <span>延迟 (RTT) / 下行带宽 (Throughput)</span>
    </div>

    {brand.speedtest.nodes.map((node) => {
      const pct = parseSpeedNum(node.download);
      return (
        <div class="rounded-xl border border-white/8 bg-[#111827]/70 p-3.5 transition hover:border-white/20">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2.5">
              <span class="inline-block h-2 w-2 rounded-full bg-[#10B981]"></span>
              <span class="font-medium text-sm text-[#F8FAFC]">{node.region}</span>
            </div>
            <div class="flex items-center gap-3 font-mono text-xs tabular-nums">
              <span class="rounded bg-white/5 px-2 py-0.5 text-[#06B6D4]">
                RTT: {node.latency}
              </span>
              <span class="rounded bg-[#10B981]/15 px-2.5 py-0.5 font-semibold text-[#10B981]">
                {node.download}
              </span>
            </div>
          </div>
          <div class="mt-2.5 h-2 w-full overflow-hidden rounded-full bg-white/5">
            <div
              class="h-full rounded-full"
              style={`width:${pct}%;background:linear-gradient(90deg, ${brand.accentColor}, #06B6D4)`}
            ></div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Original Speedtest Screenshot Evidence (if available in 16-brand measured dataset) -->
  {brand.speedtest.image && (
    <figure class="mt-7 overflow-hidden rounded-xl border border-[#10B981]/30 bg-[#111827] p-4">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded bg-[#10B981]/20 px-2 py-0.5 font-mono text-xs font-semibold text-[#10B981]">
            原始测速截图留档 (Raw Image Evidence)
          </span>
          <span class="font-mono text-xs text-[#94A3B8]">
            测试时刻：{brand.speedtest.imageTestedAt || "2026-08-11"}
          </span>
        </div>
        <a
          href={brand.speedtest.image}
          target="_blank"
          rel="noopener"
          class="font-mono text-xs text-[#06B6D4] hover:underline"
        >
          查看原尺寸高清测速图 ↗
        </a>
      </div>

      <div class="overflow-hidden rounded-lg border border-white/10 bg-[#070A14]">
        <img
          src={brand.speedtest.image}
          alt={`${brand.name} 2026-08-11 节点测速实测原图（包含延迟、下载速度与协议拓扑）`}
          loading="lazy"
          decoding="async"
          class="mx-auto max-h-[540px] w-auto object-contain"
        />
      </div>

      <figcaption class="mt-3 text-xs leading-relaxed text-[#94A3B8]">
        <strong>实测说明与局限性标注：</strong>上图为 {brand.name} 于 {brand.speedtest.imageTestedAt || "2026-08-11"} 采样的原始测速图（未做任何像素裁剪或涂改）。单次测速结果受测试者所在省份本地运营商宽带、晚高峰国际出口拥塞及目标测速服务器负载影响，仅供横向参考，不代表所有地区 24 小时恒定速率。
      </figcaption>
    </figure>
  )}

  <p class="mt-4 text-xs leading-relaxed text-[#94A3B8]">
    注：{brand.speedtest.note}
  </p>
</section>
