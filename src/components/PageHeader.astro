---
import Icon from "./Icon.astro";
import Highlight from "./Highlight.astro";

interface Props {
  /** Wrap key words in *asterisks* to show them in the accent color. */
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
}
const { title, lead, crumbs = [] } = Astro.props;
---

<section class="border-b border-line">
  <div class="container-x pt-10 pb-12 sm:pt-12 sm:pb-16">
    {
      crumbs.length > 0 && (
        <nav aria-label="面包屑导航">
          <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
            <li>
              <a href="/" class="rounded hover:text-ink">首页</a>
            </li>
            {crumbs.map((c) => (
              <li class="flex items-center gap-1.5">
                <Icon name="chevron-right" size={14} />
                {c.href ? (
                  <a href={c.href} class="rounded hover:text-ink">{c.label}</a>
                ) : (
                  <span aria-current="page" class="font-semibold text-ink">{c.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="max-w-4xl">
        <h1 class="h-display"><Highlight text={title} /></h1>
        {lead && <p class="lead mt-5">{lead}</p>}
      </div>
      <slot />
    </div>
  </div>
</section>
