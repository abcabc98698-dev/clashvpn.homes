---
import { SITE } from "../config";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="header-backdrop" aria-hidden="true"></div>
  <div class="container-x relative flex h-16 items-center justify-between gap-4 sm:h-[72px]">
    <a href="/" class="header-logo flex shrink-0 items-center gap-2.5 rounded-lg whitespace-nowrap">
      <Logo class="size-9 shrink-0 sm:size-10" />
      <span class="text-[1.125rem] leading-none font-extrabold tracking-tight text-ink">
        {SITE.shortName}
      </span>
      <span class="hidden rounded-md border border-line bg-surface px-2 py-1 text-xs font-semibold text-muted 2xl:inline-block">
        42家实测档案
      </span>
    </a>

    <nav aria-label="主导航" class="hidden shrink-0 lg:block">
      <ul class="flex flex-nowrap items-center gap-0.5 xl:gap-1.5">
        {
          SITE.nav.map((item) => (
            <li class="shrink-0">
              <a href={item.href} class="nav-link" aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2.5 whitespace-nowrap">
      <a href="/brands/guangsuyun/" class="btn btn-primary hidden min-h-10 px-4 py-2 text-sm lg:inline-flex">
        #1 光速云实测
      </a>
      <a href="/brands/guangsuyun/" class="btn btn-secondary min-h-10 px-3.5 py-2 text-xs font-bold lg:hidden">
        #1 光速云
      </a>
      <button type="button" popovertarget="mobile-nav" class="menu-btn inline-grid shrink-0 lg:hidden" aria-label="打开导航菜单">
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" popover class="mobile-nav">
    <div class="container-x flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-3 rounded-lg whitespace-nowrap">
        <Logo class="size-9 shrink-0" />
        <span class="text-[1.125rem] leading-none font-bold tracking-tight">{SITE.shortName}</span>
      </a>
      <button type="button" popovertarget="mobile-nav" popovertargetaction="hide" class="menu-btn inline-grid" aria-label="关闭导航菜单">
        <Icon name="x" />
      </button>
    </div>
    <nav aria-label="移动端导航" class="container-x pt-6">
      <ul class="divide-y divide-line border-y border-line">
        {
          SITE.nav.map((item) => (
            <li>
              <a href={item.href} class="mobile-link" aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label} <Icon name="chevron-right" />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 grid gap-3">
        <a href="/brands/guangsuyun/" class="btn btn-primary btn-lg w-full">
          查看 #1 光速云评测与优惠码
        </a>
        <a href="/brands/" class="btn btn-secondary btn-lg w-full">浏览全部 42 家品牌库</a>
      </div>
      <p class="mt-6 text-sm text-muted">{SITE.hoursNote}</p>
    </nav>
  </div>
</header>

<script>
  // Close the menu when a link inside it is followed (matters for same-page anchors).
  const menu = document.getElementById("mobile-nav");
  menu?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) menu.hidePopover();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: -0.5rem;
    z-index: 50;
    padding-top: 0.5rem;
    view-transition-name: site-header;
  }
  /* Solid bar with a hairline; it fades in as the page scrolls (see global.css). */
  .header-backdrop {
    position: absolute;
    inset: 0;
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-line);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
    padding: 0.45rem 0.68rem;
    border-radius: 0.625rem;
    font-size: 0.9125rem;
    font-weight: 600;
    color: var(--c-muted);
    transition: color 0.2s;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.68rem;
    right: 0.68rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--c-ink);
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }
  /* display comes from utility classes so lg:hidden can win */
  .menu-btn {
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-text);
    transition: transform 0.25s var(--ease-out);
  }
  .menu-btn:hover {
    transform: scale(1.06);
  }
  .menu-btn :global(.icon) {
    width: 1.375rem;
    height: 1.375rem;
  }
  .mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 0 2rem;
    border: 0;
    overflow-y: auto;
    background: var(--c-bg);
    color: var(--c-ink);
  }
  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.125rem 0.25rem;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .mobile-link :global(.icon) {
    color: var(--c-muted);
  }
  .mobile-link[aria-current="page"] {
    color: var(--accent-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav {
      transition:
        opacity 0.25s var(--ease-out),
        transform 0.3s var(--ease-out),
        overlay 0.3s allow-discrete,
        display 0.3s allow-discrete;
    }
    .mobile-nav:not(:popover-open) {
      opacity: 0;
      transform: translateY(-12px);
    }
    @starting-style {
      .mobile-nav:popover-open {
        opacity: 0;
        transform: translateY(-12px);
      }
    }
  }
</style>
