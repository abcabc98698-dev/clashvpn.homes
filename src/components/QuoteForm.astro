---
/**
 * Quote request form.
 *
 * Without JavaScript it is a plain HTML POST with a hidden _redirect to /thanks/.
 * With JavaScript it submits via fetch and stays on the page.
 * The success state is shown ONLY when the server answers { success: true }.
 */
import { getCollection } from "astro:content";
import { SITE } from "../config";
import Icon from "./Icon.astro";

interface Props {
  /** Service id (file name in src/content/services) to preselect. */
  selected?: string;
  id?: string;
}
const { selected, id = "quote" } = Astro.props;

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const accessKey = import.meta.env.PUBLIC_FORMGONG_ACCESS_KEY || SITE.formgong.accessKey;
const endpoint = import.meta.env.PUBLIC_FORMGONG_ENDPOINT || SITE.formgong.endpoint;
const redirect = new URL("/thanks/", Astro.site ?? new URL(SITE.url)).href;
const f = (name: string) => `${id}-${name}`;
---

<div class="quote-card card relative p-5 sm:p-8" data-quote data-phone={SITE.phone.display}>
  <form action={endpoint} method="POST" class="relative" data-quote-form>
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="_lang" value={SITE.lang} />
    <input type="hidden" name="_redirect" value={redirect} />
    <input type="hidden" name="_subject" value={SITE.formgong.subject} />
    <!-- Spam honeypot: never fill it, never remove it. -->
    <div aria-hidden="true" style="position:absolute;inset-inline-start:0;top:0;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">
      <input type="text" name="botcheck" tabindex="-1" autocomplete="off" />
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for={f("name")} class="field-label">您的称呼</label>
        <input id={f("name")} name="name" type="text" class="field" autocomplete="name" required maxlength="120" placeholder="例如：陈先生 / Alex" />
      </div>
      <div>
        <label for={f("phone")} class="field-label">常用运营商/设备 <span class="field-hint">(选填)</span></label>
        <input id={f("phone")} name="phone" type="tel" class="field" autocomplete="tel" inputmode="tel" maxlength="40" placeholder="例如：电信 / Win+iOS" />
      </div>
      <div class="sm:col-span-2">
        <label for={f("email")} class="field-label">接收方案的邮箱</label>
        <input id={f("email")} name="email" type="email" class="field" autocomplete="email" required maxlength="160" placeholder="name@domain.com" />
      </div>
      <div class="sm:col-span-2">
        <label for={f("service")} class="field-label">您主要关注的场景或专题</label>
        <div class="relative">
          <select id={f("service")} name="service" class="field">
            <option value="综合推荐（主力+备用双保险）">综合推荐（主力+备用双保险）</option>
            {
              services.map((s) => (
                <option value={s.data.title} selected={s.id === selected}>
                  {s.data.title}
                </option>
              ))
            }
          </select>
          <Icon name="chevron-right" size={18} class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 rotate-90 text-muted" />
        </div>
      </div>
      <div class="sm:col-span-2">
        <label for={f("message")} class="field-label">描述您的预算、月流量需求或遇到的网络问题</label>
        <textarea
          id={f("message")}
          name="message"
          rows="4"
          class="field resize-y"
          required
          maxlength="4000"
          placeholder="例如：月预算 10-15 元左右，主要用来访问 ChatGPT/Claude 和看 Netflix 4K，希望支持 Mac 和小火箭..."></textarea>
      </div>
    </div>

    <div class="form-error mt-5" data-form-error hidden>
      <Icon name="x" size={18} class="mt-0.5 shrink-0" />
      <p data-form-error-text></p>
    </div>

    <button type="submit" class="btn btn-primary btn-lg mt-6 w-full" data-submit>
      <svg class="spinner" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity=".3"></circle>
        <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
      </svg>
      <span data-submit-label>提交选型咨询请求</span>
      <Icon name="arrow-right" class="icon-shift submit-arrow" />
    </button>
    <p class="mt-4 text-center text-sm text-muted">您的信息仅用于本次订阅选型回复，亦可直接查阅站内 42 家实测数据。</p>
  </form>

  <div class="form-success py-6 text-center" data-form-success hidden>
    <svg class="mx-auto size-20 text-success" viewBox="0 0 80 80" fill="none" aria-hidden="true">
      <circle class="check-ring" pathLength="1" cx="40" cy="40" r="36" stroke="currentColor" stroke-width="4"></circle>
      <path class="check-mark" pathLength="1" d="M25 41.5 35.5 52 56 30" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <h3 class="mt-6 text-2xl font-bold tracking-tight" tabindex="-1" data-success-heading>选型咨询已收到</h3>
    <p class="mx-auto mt-3 max-w-sm text-muted">
      我们将尽快通过邮件向您发送匹配的机场对比建议。等待期间您可以直接查看榜首{" "}
      <a href="/brands/guangsuyun/" class="font-bold whitespace-nowrap text-accent-ink">#1 光速云实测档案</a>。
    </p>
    <button type="button" class="btn btn-secondary mt-8" data-form-reset>再次提交其他问题</button>
  </div>

  <p class="sr-only" role="status" data-form-live></p>
</div>

<script>
  type ServerReply = { success?: unknown; message?: unknown } | null;

  for (const card of document.querySelectorAll<HTMLElement>("[data-quote]")) {
    const form = card.querySelector<HTMLFormElement>("form[data-quote-form]");
    const success = card.querySelector<HTMLElement>("[data-form-success]");
    const errorBox = card.querySelector<HTMLElement>("[data-form-error]");
    const errorText = card.querySelector<HTMLElement>("[data-form-error-text]");
    const button = card.querySelector<HTMLButtonElement>("[data-submit]");
    const label = card.querySelector<HTMLElement>("[data-submit-label]");
    const live = card.querySelector<HTMLElement>("[data-form-live]");
    if (!form || !success || !errorBox || !errorText || !button || !label || !live) continue;

    const idleLabel = label.textContent ?? "";
    const phone = card.dataset.phone ?? "";

    const setSending = (sending: boolean) => {
      button.disabled = sending;
      form.setAttribute("aria-busy", String(sending));
      card.classList.toggle("is-sending", sending);
      label.textContent = sending ? "正在发送…" : idleLabel;
    };

    const showError = (message: string) => {
      errorText.textContent = message;
      errorBox.hidden = false;
      // Restart the shake when the same error appears twice in a row.
      errorBox.style.animation = "none";
      void errorBox.offsetWidth;
      errorBox.style.animation = "";
      live.textContent = message;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorBox.hidden = true;
      setSending(true);

      let reply: ServerReply = null;
      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        reply = await response.json().catch(() => null);
      } catch {
        setSending(false);
        showError(`暂时无法连接表单网关，请检查网络后重试，或直接浏览站内 42 家品牌库（${phone}）。`);
        return;
      }
      setSending(false);

      // The only path to the success state: the server explicitly confirmed it.
      if (reply?.success === true) {
        form.reset();
        form.hidden = true;
        success.hidden = false;
        live.textContent = "选型咨询已收到，我们将尽快回复您的邮件。";
        success.scrollIntoView({ block: "nearest" });
        success.querySelector<HTMLElement>("[data-success-heading]")?.focus({ preventScroll: true });
        return;
      }
      const message = typeof reply?.message === "string" && reply.message.trim() ? reply.message : "";
      showError(message || `请求未能发送成功，请稍后重试或直接查看 #1 光速云及 42 家品牌对比库（${phone}）。`);
    });

    card.querySelector("[data-form-reset]")?.addEventListener("click", () => {
      success.hidden = true;
      form.hidden = false;
      live.textContent = "";
      form.querySelector<HTMLElement>("input:not([type=hidden]):not([tabindex='-1'])")?.focus();
    });
  }
</script>

<style>
  .spinner {
    display: none;
  }
  .is-sending .spinner {
    display: block;
  }
  .is-sending .submit-arrow {
    display: none;
  }
  .form-error {
    display: flex;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    border-radius: 0.875rem;
    border: 1px solid color-mix(in oklab, var(--c-danger) 45%, transparent);
    background: color-mix(in oklab, var(--c-danger) 9%, var(--c-surface));
    color: var(--c-danger);
    font-weight: 600;
    line-height: 1.5;
  }
  .form-error[hidden],
  [data-form-success][hidden],
  form[hidden] {
    display: none;
  }
  [data-success-heading]:focus {
    outline: none;
  }
  button:disabled {
    cursor: progress;
    opacity: 0.85;
  }
</style>
