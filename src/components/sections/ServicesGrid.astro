---
import { getCollection } from "astro:content";
import { SITE } from "../../config";
import Icon from "../Icon.astro";
import SectionHeading from "../SectionHeading.astro";
import ServiceCard from "../ServiceCard.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" aria-labelledby="services-title">
  <div class="container-x">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        id="services-title"
        title="六大核心场景专题，与 *真实订阅成本*"
        lead={`覆盖 ${SITE.address.city} IEPL 专线、AI 大模型解锁、4K 流媒体、平价月付、永久流量包与全平台客户端教程。`}
      />
      <a href="/services/" class="btn btn-secondary reveal shrink-0 self-start lg:self-auto">
        查看全部专题 <Icon name="arrow-right" class="icon-shift" />
      </a>
    </div>
    <ul class="stagger mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, i) => (
          <li style={`--i:${i % 3}`}>
            <ServiceCard service={service} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
