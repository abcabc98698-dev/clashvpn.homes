---
import { getCollection } from "astro:content";
import Icon from "../Icon.astro";
import SectionHeading from "../SectionHeading.astro";

const faqs = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" aria-labelledby="faq-title">
  <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <SectionHeading id="faq-title" title="价格、专线原理与 *防跑路指南*" />
      <div class="card-accent reveal mt-10 p-7 sm:p-8">
        <p class="text-xl font-semibold">想按线路或预算快速筛选？</p>
        <p class="mt-2 font-medium opacity-85">
          前往全网 42 家机场检索库，支持按 IEPL/IPLC 专线、客户端类型与月均价格一键筛选对比。
        </p>
        <a href="/brands/" class="btn btn-dark mt-6">
          检索 42 家品牌库 <Icon name="arrow-right" class="icon-shift" />
        </a>
      </div>
    </div>
    <div class="stagger lg:col-span-7">
      {
        faqs.map((item, i) => (
          <details class="faq-item" style={`--i:${Math.min(i, 3)}`} name="faq">
            <summary>
              <span>{item.data.question}</span>
              <span class="faq-icon" aria-hidden="true">
                <Icon name="plus" size={20} />
              </span>
            </summary>
            <p class="faq-answer">{item.data.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item {
    border-bottom: 1px solid var(--c-line);
  }
  .faq-item:first-child {
    border-top: 1px solid var(--c-line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
    border-radius: 0.5rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--c-line);
    color: var(--accent-ink);
    transition:
      transform 0.35s var(--ease-out),
      background-color 0.2s;
  }
  summary:hover .faq-icon {
    background: var(--accent-soft);
  }
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-answer {
    max-width: 40rem;
    padding-bottom: 1.5rem;
    margin-top: -0.25rem;
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--c-muted);
  }
</style>
