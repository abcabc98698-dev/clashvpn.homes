---
import { getCollection, getEntry } from "astro:content";
import SectionHeading from "../SectionHeading.astro";

const reviews = await Promise.all(
  (await getCollection("testimonials")).map(async (t) => ({
    ...t.data,
    id: t.id,
    serviceTitle: t.data.service ? (await getEntry(t.data.service))?.data.title : undefined,
  })),
);
---

<section class="section" aria-labelledby="reviews-title">
  <div class="container-x">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading id="reviews-title" title="典型使用场景，与 *真实用户反馈*" />
      <p class="reveal text-sm text-muted lg:max-w-xs lg:text-right">
        涵盖远程研发办公、4K 杜比家庭影院及学术检索等典型网络环境。
      </p>
    </div>
    <ul class="stagger mt-14 grid gap-12 lg:grid-cols-3 lg:gap-10">
      {
        reviews.map((r, i) => (
          <li style={`--i:${i}`}>
            <figure class="flex h-full flex-col border-t border-line pt-8">
              <span class="text-6xl leading-[0.6] font-light text-accent-ink" aria-hidden="true">“</span>
              <blockquote class="mt-4 flex-1 text-[1.15rem] leading-[1.6] font-light">
                <p>{r.quote}</p>
              </blockquote>
              <figcaption class="mt-8">
                <span class="block font-semibold">{r.name}</span>
                <span class="mt-0.5 block text-sm text-muted">
                  {r.location}
                  {r.serviceTitle && <> · {r.serviceTitle}</>} · 评分 {r.rating}/5
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
